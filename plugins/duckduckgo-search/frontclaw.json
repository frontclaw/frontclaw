{
  "id": "duckduckgo-search",
  "name": "DuckDuckGo Search",
  "version": "1.0.0",
  "description": "Exposes tool + skill for web search through DuckDuckGo Instant Answer API",
  "author": {
    "name": "Frontclaw Team"
  },
  "priority": 40,
  "runtime": "docker",
  "docker": {
    "image": "oven/bun:1.3.2",
    "command": [
      "bun",
      "index.ts"
    ],
    "workdir": "/plugin",
    "network": "none",
    "readOnlyRootFs": true
  },
  "permissions": {
    "network": {
      "allowed_domains": [
        "api.duckduckgo.com"
      ],
      "allow_all": false
    },
    "skills": [
      "web_search"
    ],
    "log": {
      "enabled": true,
      "levels": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    }
  },
  "main": "index.ts",
  "tags": [
    "search",
    "duckduckgo",
    "tool",
    "skill"
  ],
  "enabled": false
}
